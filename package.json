{
  "name": "lake-michigan-auction-watch",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx && npm run build && node --test tests/static-artifact.test.mjs",
    "lint": "eslint src tests scripts --max-warnings=0",
    "refresh": "node scripts/refresh-catalogs.mjs",
    "refresh:check": "npm run refresh && npm run test"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "jsdom": "^29.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "^8.2.1"
  },
  "type": "module",
  "displayName": "Lake Michigan Auction Watch"
}
